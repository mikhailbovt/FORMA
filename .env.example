# Local Compose settings. Copy this file to .env before changing defaults.
COMPOSE_PROJECT_NAME=forma
WEB_PORT=3000

# Keep this exact browser origin in sync with WEB_PORT. Set COOKIE_SECURE=true
# only when Forma is served through HTTPS.
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# These credentials protect only the PostgreSQL container on the private
# Compose network. Use a strong value when the stack is reachable by others.
POSTGRES_DB=forma
POSTGRES_USER=forma
POSTGRES_PASSWORD=change-me-local-only

# API runtime limits.
AI_SESSION_TTL=30m
MAX_BODY_BYTES=2097152

# Provider API keys intentionally do not belong here. Enter them in Forma's
# provider dialog; the API keeps them only in short-lived process memory.
